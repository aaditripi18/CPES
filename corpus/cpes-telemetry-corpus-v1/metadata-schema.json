{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpes-telemetry-corpus-v1-metadata-schema",
  "title": "CPES corpus metadata",
  "type": "object",
  "$defs": {
    "executionBracket": {
      "type": "object",
      "required": [
        "run_id",
        "run_type",
        "variant",
        "started_at",
        "ended_at",
        "operator",
        "cleanup_status",
        "evidence_reference"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^m2-[a-f0-9]{16}$"},
        "run_type": {"enum": ["attack", "benign"]},
        "technique_id": {"type": ["string", "null"]},
        "atomic_test_id": {"type": ["string", "null"]},
        "variant": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "operator": {"type": "string", "minLength": 1},
        "cleanup_status": {"type": "string", "minLength": 1},
        "evidence_reference": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"run_type": {"const": "attack"}}},
          "then": {
            "required": ["technique_id", "atomic_test_id"],
            "properties": {
              "technique_id": {"type": "string", "minLength": 1},
              "atomic_test_id": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "manifest": {
      "type": "object",
      "required": ["corpus_version", "status", "source_environment", "archive"],
      "properties": {
        "corpus_version": {"const": "cpes-telemetry-corpus-v1"},
        "status": {"enum": ["template", "frozen"]},
        "source_environment": {"type": "object"},
        "archive": {"type": "object"}
      }
    }
  }
}
